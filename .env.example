# Nombre del Proyecto y Prefijo API
PROJECT_NAME=MiNegocioApp
API_V1_STR=/api/v1

# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nombre_db

# Configuración de CORS (Orígenes Permitidos)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Seguridad y Autenticación JWT
SECRET_KEY=cambiar-por-una-clave-secreta-muy-larga-y-segura
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Información General del Negocio (Ficticio)
BUSINESS_NAME="Nombre de Tu Empresa"
BUSINESS_RIF="J-12345678-9"
BUSINESS_PHONE="+58 412-1234567"
BUSINESS_ADDRESS="Calle Principal, Sector Centro, Ciudad, Estado, País"
BUSINESS_EMAIL="contacto@tuempresa.com"

# Información de Métodos de Pago (Para generación de comprobantes y QRs)
PAGO_MOVIL_BANCO="0102"
PAGO_MOVIL_TELEFONO="04121234567"
PAGO_MOVIL_RIF_CI="V-12345678"
PAGO_MOVIL_NOMBRE="Nombre Titular Pago Móvil"
PAYPAL_CORREO="pagos@tuempresa.com"
BINANCE_PAY_ID="123456789"
ZINLI_CORREO="pagos.zinli@tuempresa.com"
AIRTM_CORREO="pagos.airtm@tuempresa.com"

# Almacenamiento de Imágenes ('local' o 'r2')
STORAGE_MODE=local
R2_BUCKET=tu-bucket-nombre
R2_ACCESS_KEY=tu-r2-access-key
R2_SECRET_KEY=tu-r2-secret-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Configuración de Servidor SMTP (Para envío automatizado de correos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo-emisor@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicación-smtp
SMTP_FROM="Nombre Negocio <tu-correo-emisor@gmail.com>"
